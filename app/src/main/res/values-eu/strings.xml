    <string name="about_version_unknown">Bertsio ezezaguna</string>
    <string name="about_purpose">Parabola bat satelite geoezegonkor batera zuzentzeko: mugikorra da tresna eta pantaila, erantzuna.</string>
    <string name="about_location">Kokapena ez da telefonotik ateratzen: app-ak ezin du sarea atzitu, eta sentsoreak eta GPSa pantaila piztuta dagoenean baino ez dira irakurtzen.</string>
    <string name="about_catalogue">Katalogoa CelesTrak-ek argitaratzen dituen satelite geoezegonkorren zerrenda da, beren posizio nominalekin.</string>
    <string name="about_author">Egilea: %1$s &lt;%2$s&gt;</string>
    <string name="about_donate">App hau gustuko baduzu eta garapena babestu nahi baduzu eguneratuta egon dadin, %1$s.</string>
    <string name="about_donate_link">dohaintza txiki bat egin dezakezu</string>
