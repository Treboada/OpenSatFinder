    <string name="about">Acerca de OpenSatFinder</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_version_unknown">Versión desconocida</string>
    <string name="about_purpose">Sirve para apuntar una parabólica a un satélite geoestacionario: el móvil es el instrumento y la pantalla, la respuesta.</string>
    <string name="about_location">La ubicación no sale del teléfono: la app no puede acceder a la red, y los sensores y el GPS solo se leen con la pantalla encendida.</string>
    <string name="about_catalogue">El catálogo es la lista de satélites geoestacionarios que publica CelesTrak, con sus posiciones nominales.</string>
