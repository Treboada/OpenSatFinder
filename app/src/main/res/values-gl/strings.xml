    <string name="about">Acerca de OpenSatFinder</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_version_unknown">Versión descoñecida</string>
    <string name="about_purpose">Serve para apuntar unha parabólica a un satélite xeoestacionario: o móbil é o instrumento e a pantalla, a resposta.</string>
    <string name="about_location">A localización non sae do teléfono: a app non pode acceder á rede, e os sensores e o GPS só se len coa pantalla acendida.</string>
    <string name="about_catalogue">O catálogo é a lista de satélites xeoestacionarios que publica CelesTrak, coas súas posicións nominais.</string>
