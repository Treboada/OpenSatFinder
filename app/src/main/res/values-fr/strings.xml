    <string name="about">À propos d\'OpenSatFinder</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_version_unknown">Version inconnue</string>
    <string name="about_purpose">Sert à pointer une parabole vers un satellite géostationnaire : le téléphone devient l\'instrument et l\'écran la réponse.</string>
    <string name="about_location">La position ne quitte pas le téléphone : l\'app ne peut pas accéder au réseau, et les capteurs et le GPS ne sont lus que lorsque l\'écran est allumé.</string>
    <string name="about_catalogue">Le catalogue est la liste des satellites géostationnaires publiée par CelesTrak, avec leurs positions nominales.</string>
    <string name="about_author">Auteur : %1$s &lt;%2$s&gt;</string>
    <string name="about_donate">Si tu aimes cette app et que tu veux soutenir son développement pour qu\'elle reste à jour, %1$s.</string>
