<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The faint guide ring the sight is measured against (#172939) -->
    <path
        android:pathData="M 54.0,54.0 m -30.46,0 a 30.46,30.46 0 1,0 60.92,0 a 30.46,30.46 0 1,0 -60.92,0"
        android:strokeWidth="2.96"
        android:strokeColor="#172939" />

    <!-- The white outer arc of the sight, 42.6° to 251.3°, inside the 66 dp safe zone -->
    <path
        android:pathData="M 76.42,74.62 A 30.46,30.46 0 1,1 44.23,25.15"
        android:strokeWidth="2.96"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="butt" />

    <!-- The rear strut joining the dish to the outer arc -->
    <path
        android:pathData="M 32.46,75.54 L 38.08,69.92"
        android:strokeWidth="2.96"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="butt" />

    <!-- The dish: an arc closed by a straight chord, corners mitred -->
    <path
        android:pathData="M 35.39,48.38 A 17.68,17.68 0 0,0 59.62,72.61 Z"
        android:strokeWidth="2.96"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="miter" />

    <!-- The sight line itself, straight at the satellite -->
    <path
        android:pathData="M 47.5,60.5 L 66.69,41.31"
        android:strokeWidth="2.96"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="butt" />

    <!-- The geostationary satellite, aligned (#02BD69) -->
    <path
        android:fillColor="#02BD69"
        android:pathData="M 70.9,37.01 m -4.43,0 a 4.43,4.43 0 1,0 8.86,0 a 4.43,4.43 0 1,0 -8.86,0" />
</vector>
