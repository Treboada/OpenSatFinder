    <string name="about">About OpenSatFinder</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_version_unknown">Version unknown</string>
    <string name="about_purpose">Points a dish at a geostationary satellite: the phone is the instrument and the screen is the answer.</string>
    <string name="about_location">The position never leaves the phone: the app cannot reach the network, and the sensors and the GPS are read only while the screen is on.</string>
    <string name="about_catalogue">The catalogue is the list of geostationary satellites CelesTrak publishes, with their nominal slots.</string>
    <string name="about_author">Author: %1$s &lt;%2$s&gt;</string>
