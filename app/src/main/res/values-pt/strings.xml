    <string name="about">Acerca de OpenSatFinder</string>
    <string name="about_version">Versão %1$s</string>
    <string name="about_version_unknown">Versão desconhecida</string>
    <string name="about_purpose">Serve para apontar uma parabólica a um satélite geoestacionário: o telemóvel é o instrumento e o ecrã, a resposta.</string>
    <string name="about_location">A localização não sai do telemóvel: a app não pode aceder à rede, e os sensores e o GPS só são lidos com o ecrã ligado.</string>
    <string name="about_catalogue">O catálogo é a lista de satélites geoestacionários que a CelesTrak publica, com as suas posições nominais.</string>
